<div class="customer customer--wide">

  <nav class="breadcrumb" aria-label="Fil d'Ariane">
    <a href="{{ routes.account_url }}">Mon compte</a>
    <span class="breadcrumb__separator">/</span>
    <span>Commande {{ order.name }}</span>
  </nav>

  <h1 style="font-size:clamp(1.5rem,4vw,2.25rem); text-transform:uppercase; letter-spacing:0.04em; margin-bottom:0.5rem;">Commande {{ order.name }}</h1>
  <p style="color:var(--color-text-muted); margin-bottom:2rem;">
    Passée le {{ order.created_at | date: '%d %B %Y à %H:%M' }} &middot;
    Paiement : {{ order.financial_status_label }} &middot;
    Livraison : {{ order.fulfillment_status_label | default: 'En attente' }}
  </p>

  <div class="account-grid">
    <section>
      <h2 style="font-size:1rem; text-transform:uppercase; margin-bottom:1rem;">Articles</h2>
      <table class="cart-table">
        <thead>
          <tr>
            <th colspan="2">Produit</th>
            <th>Prix</th>
            <th>Qté</th>
            <th>Total</th>
          </tr>
        </thead>
        <tbody>
          {% for line_item in order.line_items %}
            <tr>
              <td style="width:80px;">
                {% if line_item.image %}<img src="{{ line_item.image | image_url: width: 150 }}" alt="{{ line_item.title | escape }}">{% endif %}
              </td>
              <td>
                <strong style="text-transform:uppercase;">{{ line_item.product.title }}</strong>
                {% if line_item.variant.title and line_item.variant.title != 'Default Title' %}<div style="font-size:0.8rem; color:var(--color-text-muted);">{{ line_item.variant.title }}</div>{% endif %}
              </td>
              <td>{{ line_item.price | money }}</td>
              <td>{{ line_item.quantity }}</td>
              <td>{{ line_item.final_line_price | money }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>

      <div style="margin-top:1.5rem; max-width:340px; margin-left:auto;">
        <div class="cart-summary__row"><span>Sous-total</span><span>{{ order.subtotal_price | money }}</span></div>
        {% for discount_application in order.discount_applications %}
          <div class="cart-summary__row"><span>Réduction ({{ discount_application.title }})</span><span>-{{ discount_application.total_allocated_amount | money }}</span></div>
        {% endfor %}
        <div class="cart-summary__row"><span>Livraison</span><span>{{ order.shipping_price | money }}</span></div>
        <div class="cart-summary__row"><span>Taxes</span><span>{{ order.tax_price | money }}</span></div>
        <div class="cart-summary__row cart-summary__row--total"><span>Total</span><span>{{ order.total_price | money }}</span></div>
      </div>
    </section>

    <aside>
      {% if order.shipping_address %}
        <h2 style="font-size:1rem; text-transform:uppercase; margin-bottom:1rem;">Adresse de livraison</h2>
        <div style="background:#fafafa; padding:1rem; border:1px solid var(--color-border); font-size:0.9rem; line-height:1.6; margin-bottom:1.5rem;">
          {{ order.shipping_address | format_address }}
        </div>
      {% endif %}
      {% if order.billing_address %}
        <h2 style="font-size:1rem; text-transform:uppercase; margin-bottom:1rem;">Adresse de facturation</h2>
        <div style="background:#fafafa; padding:1rem; border:1px solid var(--color-border); font-size:0.9rem; line-height:1.6;">
          {{ order.billing_address | format_address }}
        </div>
      {% endif %}
    </aside>
  </div>

  <div style="margin-top:2rem;">
    <a href="{{ routes.account_url }}" class="btn btn--outline">&larr; Retour à mon compte</a>
  </div>
</div>
