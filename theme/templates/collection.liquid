<div class="collection-page">
  <div class="container">

    <div class="collection-hero">
      <h1 class="collection-hero__title">{{ collection.title | upcase }}</h1>
      {% if collection.description != blank %}
        <p class="collection-hero__desc" style="color:#777; margin-top:0.5rem; font-size:0.9rem; max-width:600px;">{{ collection.description }}</p>
      {% endif %}
      <p class="collection-hero__count">{{ collection.products_count }} producten</p>
    </div>

    <div class="collection-toolbar">
      <span style="font-size:0.82rem; color:#777;">{{ collection.products_count }} producten</span>
      <div class="collection-sort">
        <label for="SortBy">Sorteren op:</label>
        <select id="SortBy" name="sort_by" onchange="window.location.search='?sort_by='+this.value">
          <option value="manual" {% if collection.sort_by == 'manual' %}selected{% endif %}>Aanbevolen</option>
          <option value="price-ascending" {% if collection.sort_by == 'price-ascending' %}selected{% endif %}>Prijs: laag naar hoog</option>
          <option value="price-descending" {% if collection.sort_by == 'price-descending' %}selected{% endif %}>Prijs: hoog naar laag</option>
          <option value="title-ascending" {% if collection.sort_by == 'title-ascending' %}selected{% endif %}>Naam A-Z</option>
          <option value="created-descending" {% if collection.sort_by == 'created-descending' %}selected{% endif %}>Nieuwste eerst</option>
          <option value="best-selling" {% if collection.sort_by == 'best-selling' %}selected{% endif %}>Bestsellers</option>
        </select>
      </div>
    </div>

    <div class="products-grid">
      {% for product in collection.products %}
        {% render 'product-card', product: product %}
      {% else %}
        <p style="grid-column:1/-1; color:#777; padding:2rem 0;">Geen producten gevonden in deze collectie.</p>
      {% endfor %}
    </div>

    {% if paginate.pages > 1 %}
      {% paginate collection.products by 24 %}
        <nav class="pagination" aria-label="Paginering">
          {% if paginate.previous %}
            <a href="{{ paginate.previous.url }}" class="pagination__item" aria-label="Vorige">&#x2039;</a>
          {% endif %}
          {% for part in paginate.parts %}
            {% if part.is_link %}
              <a href="{{ part.url }}" class="pagination__item {% if part.is_link == false %}active{% endif %}">{{ part.title }}</a>
            {% else %}
              <span class="pagination__item active">{{ part.title }}</span>
            {% endif %}
          {% endfor %}
          {% if paginate.next %}
            <a href="{{ paginate.next.url }}" class="pagination__item" aria-label="Volgende">&#x203A;</a>
          {% endif %}
        </nav>
      {% endpaginate %}
    {% endif %}

  </div>
</div>
