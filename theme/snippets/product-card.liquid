<div class="product-card">
  <a href="{{ product.url }}" class="product-card__image-wrap" tabindex="-1" aria-hidden="true">
    {% if product.featured_image %}
      <img src="{{ product.featured_image | image_url: width: 600 }}"
           alt="{{ product.featured_image.alt | default: product.title | escape }}"
           loading="lazy" width="600" height="600">
    {% else %}
      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {% endif %}
    {% if product.available == false %}
      <span class="product-card__badge" style="background:#999;">Uitverkocht</span>
    {% elsif product.compare_at_price > product.price %}
      <span class="product-card__badge" style="background:#e53935;">Sale</span>
    {% endif %}
  </a>
  <div class="product-card__body">
    <h3 class="product-card__title">
      <a href="{{ product.url }}">{{ product.title | upcase }}</a>
    </h3>
    <div class="product-card__price">
      {% if product.compare_at_price > product.price %}
        {{ product.price | money }}
        <s>{{ product.compare_at_price | money }}</s>
      {% else %}
        {{ product.price | money }}
      {% endif %}
    </div>
    {% if product.available %}
      <button class="product-card__atc"
              data-product-id="{{ product.variants.first.id }}"
              data-add-to-cart
              aria-label="{{ product.title | escape }} in winkelwagen">
        In winkelwagen
      </button>
    {% else %}
      <button class="product-card__atc" disabled style="opacity:0.5;cursor:not-allowed;">
        Uitverkocht
      </button>
    {% endif %}
  </div>
</div>
