<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0">
  <meta name="theme-color" content="#ffffff">

  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif %}
    {%- if current_page != 1 %} &ndash; Pagina {{ current_page }}{% endif %}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}
  </title>

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% else %}
    <meta name="description" content="{{ shop.description | default: 'MB Nutrition - Premium supplementen voor maximale prestaties.' | escape }}">
  {% endif %}

  <link rel="canonical" href="{{ canonical_url }}">

  {% if settings.favicon %}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {% endif %}

  <meta property="og:title" content="{{ page_title | default: shop.name | escape }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:site_name" content="{{ shop.name }}">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

  {{ 'theme.css' | asset_url | stylesheet_tag }}

  <style>
    :root {
      --color-bg: #ffffff;
      --color-bg-light: #f5f5f5;
      --color-bg-dark: #1a1a1a;
      --color-bg-darker: #111111;
      --color-accent: #C8A84B;
      --color-accent-hover: #b5943a;
      --color-text: #1a1a1a;
      --color-text-light: #ffffff;
      --color-text-muted: #777777;
      --color-border: #e5e5e5;
      --color-border-dark: #2a2a2a;
      --font-body: 'Inter', sans-serif;
      --header-height: 64px;
      --announcement-height: 38px;
      --border-radius: 3px;
      --transition: 0.2s ease;
      --shadow: 0 4px 20px rgba(0,0,0,0.1);
    }
  </style>

  {{ content_for_header }}
</head>

<body class="template-{{ template.name }} {% if customer %}customer-logged-in{% endif %}">

  <a class="skip-to-content" href="#MainContent">Skip to content</a>

  {% render 'cart-drawer' %}
  <div class="overlay" id="Overlay" aria-hidden="true"></div>

  {% section 'header' %}

  <main id="MainContent" class="main-content" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}

  <script>
    window.shopUrl = '{{ shop.url }}';
    window.routes = {
      cart_add_url: '{{ routes.cart_add_url }}',
      cart_change_url: '{{ routes.cart_change_url }}',
      cart_update_url: '{{ routes.cart_update_url }}',
      cart_url: '{{ routes.cart_url }}'
    };
    window.theme = {
      moneyFormat: {{ shop.money_format | json }},
      currency: '{{ shop.currency }}'
    };
  </script>

  <script src="{{ 'theme.js' | asset_url }}" defer></script>

</body>
</html>
