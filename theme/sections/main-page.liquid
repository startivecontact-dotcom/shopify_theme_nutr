<div class="page">
  <div class="container">
    {% if section.settings.show_title %}
      <h1 class="page__title">{{ page.title | upcase }}</h1>
    {% endif %}
    <div class="page__content rte">
      {{ page.content }}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Page",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "show_title", "label": "Afficher le titre", "default": true }
  ]
}
{% endschema %}
