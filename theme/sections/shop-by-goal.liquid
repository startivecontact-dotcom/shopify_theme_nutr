<section class="shop-by-goal">

  {% if section.settings.hero_image or section.settings.hero_title != blank %}
  <div class="shop-by-goal__hero">
    {% if section.settings.hero_image %}
      <div class="shop-by-goal__hero-bg">
        <img src="{{ section.settings.hero_image | image_url: width: 1600 }}"
             alt="{{ section.settings.hero_image.alt | default: 'Bundles' }}"
             loading="lazy" width="1600" height="600">
      </div>
    {% else %}
      <div class="shop-by-goal__hero-bg" style="background:#222;"></div>
    {% endif %}
    <div class="shop-by-goal__hero-overlay"></div>
    <div class="shop-by-goal__hero-content">
      {% if section.settings.hero_tag != blank %}
        <span class="shop-by-goal__hero-tag">{{ section.settings.hero_tag }}</span>
      {% endif %}
      <h2 class="shop-by-goal__hero-title">{{ section.settings.hero_title | default: 'Nu extra scherp geprijsd' }}</h2>
      {% if section.settings.hero_btn_text != blank %}
        <a href="{{ section.settings.hero_btn_link | default: '/collections/bundles' }}" class="shop-by-goal__hero-btn">
          {{ section.settings.hero_btn_text }}
        </a>
      {% endif %}
    </div>
  </div>
  {% endif %}

  <div class="shop-by-goal__grid">
    {% for block in section.blocks %}
      <div class="goal-card" {{ block.shopify_attributes }}>
        {% if block.settings.image %}
          <div class="goal-card__bg">
            <img src="{{ block.settings.image | image_url: width: 800 }}"
                 alt="{{ block.settings.title }}"
                 loading="lazy" width="800" height="600">
          </div>
        {% else %}
          <div class="goal-card__bg" style="background:{% cycle '#2a2a2a', '#1e1e1e', '#252525', '#1a1a1a' %};">
            <div class="goal-card__placeholder"></div>
          </div>
        {% endif %}
        <div class="goal-card__overlay"></div>
        <div class="goal-card__content">
          <h3 class="goal-card__title">{{ block.settings.title }}</h3>
          <a href="{{ block.settings.link | default: routes.collections_url }}" class="goal-card__btn">
            Shop nu
          </a>
        </div>
      </div>
    {% endfor %}
  </div>

</section>

{% schema %}
{
  "name": "Shop op doel",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero achtergrondafbeelding"
    },
    {
      "type": "text",
      "id": "hero_tag",
      "label": "Hero label",
      "default": "Bundles"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero titel",
      "default": "Nu extra scherp geprijsd"
    },
    {
      "type": "text",
      "id": "hero_btn_text",
      "label": "Hero knooptekst",
      "default": "Shop alle bundles"
    },
    {
      "type": "url",
      "id": "hero_btn_link",
      "label": "Hero knoplink"
    }
  ],
  "blocks": [
    {
      "type": "goal",
      "name": "Doelstelling",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Afbeelding"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Naam",
          "default": "Afvallen"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop op doel",
      "blocks": [
        { "type": "goal", "settings": { "title": "Afvallen" } },
        { "type": "goal", "settings": { "title": "Spieropbouw" } },
        { "type": "goal", "settings": { "title": "Lifestyle" } },
        { "type": "goal", "settings": { "title": "Stamina" } }
      ]
    }
  ]
}
{% endschema %}
