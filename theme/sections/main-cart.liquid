<div class="cart-page">
  <div class="container">

    {% if cart.item_count == 0 %}
      <div class="cart-empty">
        <h1>MON PANIER</h1>
        <p style="margin: 1rem 0; color: var(--color-text-muted);">Votre panier est vide.</p>
        <a href="/collections/all" class="btn btn--primary">Continuer mes achats</a>
      </div>
    {% else %}

      <h1 class="cart-page__title">MON PANIER ({{ cart.item_count }})</h1>

      <form action="{{ routes.cart_url }}" method="post" novalidate>
        <div class="cart-page__layout">

          <div>
            <table class="cart-table">
              <thead>
                <tr>
                  <th colspan="2">Produit</th>
                  <th>Prix</th>
                  <th>Quantité</th>
                  <th>Total</th>
                </tr>
              </thead>
              <tbody>
                {% for item in cart.items %}
                  <tr data-key="{{ item.key }}">
                    <td style="width:90px;">
                      <a href="{{ item.url }}">
                        {% if item.image %}
                          <img src="{{ item.image | image_url: width: 150 }}" alt="{{ item.title | escape }}" loading="lazy">
                        {% endif %}
                      </a>
                    </td>
                    <td>
                      <a href="{{ item.url }}" style="font-weight:700; text-transform:uppercase;">{{ item.product_title }}</a>
                      {% if item.variant_title %}<div style="font-size:0.8rem; color:var(--color-text-muted); margin-top:0.25rem;">{{ item.variant_title }}</div>{% endif %}
                    </td>
                    <td>{{ item.final_price | money }}</td>
                    <td>
                      <div class="product__qty">
                        <button type="button" class="qty-btn" data-cart-change="{{ item.key }}" data-delta="-1">−</button>
                        <input type="number" min="0" value="{{ item.quantity }}" data-cart-qty="{{ item.key }}" name="updates[{{ item.key }}]" aria-label="Quantité">
                        <button type="button" class="qty-btn" data-cart-change="{{ item.key }}" data-delta="1">+</button>
                      </div>
                    </td>
                    <td><strong>{{ item.final_line_price | money }}</strong></td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>

            {% if section.settings.show_order_note %}
              <div style="margin-top:1.5rem;">
                <label for="CartNote" class="field__label">Note de commande</label>
                <textarea id="CartNote" name="note" rows="3" placeholder="Instructions de livraison...">{{ cart.note }}</textarea>
              </div>
            {% endif %}
          </div>

          <aside class="cart-summary">
            <h2>Récapitulatif</h2>
            <div class="cart-summary__row">
              <span>Sous-total</span>
              <span>{{ cart.total_price | money }}</span>
            </div>
            <div class="cart-summary__note">
              Livraison gratuite dès {{ settings.free_shipping_threshold | default: 80 }}€. Taxes incluses.
            </div>
            <div class="cart-summary__row cart-summary__row--total">
              <span>Total</span>
              <span>{{ cart.total_price | money }}</span>
            </div>
            <a href="/checkout" class="btn btn--primary btn--full" style="margin-top:1rem;">Commander</a>
            <a href="/collections/all" class="btn btn--outline btn--full" style="margin-top:0.5rem;">Continuer mes achats</a>
          </aside>

        </div>
      </form>

    {% endif %}

  </div>
</div>

{% schema %}
{
  "name": "Panier",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "show_order_note", "label": "Afficher la note de commande", "default": true }
  ]
}
{% endschema %}
