{% comment %}
  MB Nutrition — Bestsellers / Featured Products Section
  Header: label + large title | right: view-all link + carousel arrows
  4-column product carousel
{% endcomment %}

<section class="bestsellers" id="bestsellers" aria-labelledby="bestsellers-title">
  <div class="container">

    <div class="bestsellers__header">
      <div class="bestsellers__header-left">
        <p class="bestsellers__label">
          {{ section.settings.label | default: 'ONTDEK ONZE BESTSELLERS' }}
        </p>
        <h2 class="bestsellers__title" id="bestsellers-title">
          {{ section.settings.heading | default: 'MB NUTRITION' }}
        </h2>
      </div>
      <div class="bestsellers__header-right">
        {%- if section.settings.view_all_url != blank -%}
          <a href="{{ section.settings.view_all_url }}" class="bestsellers__view-all">
            BEKIJK ALLE PRODUCTEN &rarr;
          </a>
        {%- else -%}
          <a href="{{ routes.all_products_collection_url }}" class="bestsellers__view-all">
            BEKIJK ALLE PRODUCTEN &rarr;
          </a>
        {%- endif -%}
        <div class="carousel-arrows">
          <button class="carousel-arrow" data-carousel-prev aria-label="Vorige" data-carousel-prev>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <polyline points="15 18 9 12 15 6"/>
            </svg>
          </button>
          <button class="carousel-arrow" data-carousel-next aria-label="Volgende">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <polyline points="9 18 15 12 9 6"/>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Product Carousel -->
    <div class="product-carousel" data-carousel>
      <div class="product-carousel__track" data-carousel-track>

        {%- if section.settings.collection != blank -%}
          {%- assign products = collections[section.settings.collection].products -%}
          {%- for product in products limit: section.settings.products_to_show -%}
            {% render 'product-card', product: product %}
          {%- else -%}
            {%- for i in (1..4) -%}
              <div class="product-card" style="flex:0 0 calc(25% - 15px);">
                <div class="product-card__image-wrap" style="background:#e8e8e8;display:flex;align-items:center;justify-content:center;aspect-ratio:1;">
                  <span style="color:#ccc;font-size:11px;letter-spacing:.1em;">PRODUCT {{ i }}</span>
                </div>
                <div class="product-card__body">
                  <div class="product-card__title">Voorbeeld product {{ i }}</div>
                  <div class="product-card__price-row">
                    <span class="product-card__price">&euro; 29,95</span>
                  </div>
                </div>
              </div>
            {%- endfor -%}
          {%- endfor -%}
        {%- else -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'product' and block.settings.product != blank -%}
              {%- assign bp = all_products[block.settings.product] -%}
              {% render 'product-card', product: bp %}
            {%- endif -%}
          {%- endfor -%}

          {%- comment -%}Fallback static cards{%- endcomment -%}
          {%- if section.blocks.size == 0 -%}
            <div class="product-card" style="flex:0 0 calc(25% - 15px);">
              <div class="product-card__image-wrap"></div>
              <div class="product-card__body">
                <div class="product-card__title">Starter Pack</div>
                <div class="product-card__price-row"><span class="product-card__price">&euro; 49,95</span></div>
              </div>
            </div>
            <div class="product-card" style="flex:0 0 calc(25% - 15px);">
              <div class="product-card__image-wrap"></div>
              <div class="product-card__body">
                <div class="product-card__title">M3 + M4 Support</div>
                <div class="product-card__price-row"><span class="product-card__price">&euro; 59,95</span></div>
              </div>
            </div>
            <div class="product-card" style="flex:0 0 calc(25% - 15px);">
              <div class="product-card__image-wrap"></div>
              <div class="product-card__body">
                <div class="product-card__title">Secret Balance + Burner</div>
                <div class="product-card__price-row"><span class="product-card__price">&euro; 59,95</span></div>
              </div>
            </div>
            <div class="product-card" style="flex:0 0 calc(25% - 15px);">
              <div class="product-card__image-wrap"></div>
              <div class="product-card__body">
                <div class="product-card__title">Secret Burner Citrus Berries</div>
                <div class="product-card__price-row"><span class="product-card__price">&euro; 29,95</span></div>
              </div>
            </div>
          {%- endif -%}
        {%- endif -%}

      </div><!-- /.product-carousel__track -->
    </div><!-- /.product-carousel -->

  </div><!-- /.container -->
</section>

{% schema %}
{
  "name": "Bestsellers",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Klein label",
      "default": "ONTDEK ONZE BESTSELLERS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Grote koptekst",
      "default": "MB NUTRITION"
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "Bekijk alle link"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Producten uit collectie"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 1,
      "label": "Aantal producten",
      "default": 8
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bestsellers"
    }
  ]
}
{% endschema %}
