{% comment %}
  MB Nutrition — Newsletter Section
  Light grey bg, left text + form, right athlete image (b&w)
{% endcomment %}

<section class="newsletter-section" id="newsletter" aria-labelledby="newsletter-title">
  <div class="newsletter-section__inner">

    <div class="newsletter-section__content">

      <div>
        <p class="newsletter-section__label">Blijf op de hoogte</p>
        <h2 class="newsletter-section__title" id="newsletter-title">
          {{ section.settings.heading | default: 'nieuws en acties.' }}
        </h2>
      </div>

      {%- if section.settings.subtext != blank -%}
        <p class="newsletter-section__subtitle">{{ section.settings.subtext }}</p>
      {%- else -%}
        <p class="newsletter-section__subtitle">
          Schrijf je in voor onze nieuwsbrief en ontvang exclusieve aanbiedingen,<br>
          nieuwe productlanceringen en voedingstips.
        </p>
      {%- endif -%}

      <form
        method="post"
        action="/contact#newsletter"
        class="newsletter-form"
        data-newsletter-form
        aria-label="Nieuwsbrief aanmelden">
        <input type="hidden" name="form_type" value="customer">
        <input type="hidden" name="utf8" value="✓">
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input
          type="email"
          name="contact[email]"
          class="newsletter-form__input"
          placeholder="{{ section.settings.placeholder | default: 'Jouw e-mailadres...' }}"
          required
          autocomplete="email"
          aria-label="E-mailadres">
        <button type="submit" class="newsletter-form__submit">
          {{ section.settings.button_label | default: 'Aanmelden' }}
        </button>
      </form>

      <p style="font-size:11px;color:#999;margin-top:-8px;">
        Door je aan te melden ga je akkoord met onze <a href="/policies/privacy-policy" style="text-decoration:underline;">privacybeleid</a>.
      </p>

    </div><!-- /.newsletter-section__content -->

    <div class="newsletter-section__image" aria-hidden="true">
      {%- if section.settings.image != blank -%}
        <img
          src="{{ section.settings.image | image_url: width: 800 }}"
          alt="{{ section.settings.image.alt | default: 'MB Nutrition athlete' }}"
          loading="lazy">
      {%- else -%}
        <div style="width:100%;height:100%;min-height:420px;background:linear-gradient(135deg,#2a2a2a 0%,#404040 100%);display:flex;align-items:center;justify-content:center;">
          <span style="color:rgba(255,255,255,.15);font-size:11px;letter-spacing:.2em;text-transform:uppercase;">Athlete Image</span>
        </div>
      {%- endif -%}
    </div>

  </div><!-- /.newsletter-section__inner -->
</section>

{% schema %}
{
  "name": "Nieuwsbrief",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Koptekst",
      "default": "nieuws en acties."
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtekst"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Invoerveld placeholder",
      "default": "Jouw e-mailadres..."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Knoptekst",
      "default": "Aanmelden"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Athlete afbeelding (rechts)"
    }
  ],
  "presets": [
    {
      "name": "Nieuwsbrief"
    }
  ]
}
{% endschema %}
