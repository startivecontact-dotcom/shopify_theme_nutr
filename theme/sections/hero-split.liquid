<div class="hero-split">
  <div class="hero-split__panel hero-split__panel--left">
    {% if section.settings.image_left %}
      <img src="{{ section.settings.image_left | image_url: width: 900 }}"
           alt="{{ section.settings.image_left_alt | default: 'MB Nutrition' }}"
           loading="eager"
           width="900" height="600">
    {% else %}
      <div class="hero-split__placeholder">
        MB NUTRITION WAREHOUSE
      </div>
    {% endif %}
    <div class="hero-split__overlay"></div>
  </div>

  <div class="hero-split__divider"></div>

  <div class="hero-split__panel hero-split__panel--right">
    {% if section.settings.image_right %}
      <img src="{{ section.settings.image_right | image_url: width: 900 }}"
           alt="{{ section.settings.image_right_alt | default: 'MB Nutrition' }}"
           loading="eager"
           width="900" height="600">
    {% else %}
      <div class="hero-split__placeholder">
        MB NUTRITION FACILITY
      </div>
    {% endif %}
    <div class="hero-split__overlay"></div>
  </div>
</div>

{% schema %}
{
  "name": "Hero - Gesplitst beeld",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_left",
      "label": "Afbeelding links"
    },
    {
      "type": "text",
      "id": "image_left_alt",
      "label": "Alt-tekst links",
      "default": "MB Nutrition"
    },
    {
      "type": "image_picker",
      "id": "image_right",
      "label": "Afbeelding rechts"
    },
    {
      "type": "text",
      "id": "image_right_alt",
      "label": "Alt-tekst rechts",
      "default": "MB Nutrition"
    }
  ],
  "presets": [
    {
      "name": "Hero - Gesplitst beeld"
    }
  ]
}
{% endschema %}
