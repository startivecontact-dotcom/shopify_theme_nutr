{% comment %}
  MB Nutrition — Hero Banner Section
  Split 2-image hero (left panel + right panel)
  Each panel has optional text overlay
{% endcomment %}

<section class="hero-split" aria-label="Hero">

  <!-- Left Panel -->
  <div class="hero-split__panel">
    {%- if section.settings.image_left != blank -%}
      <img
        src="{{ section.settings.image_left | image_url: width: 1000 }}"
        alt="{{ section.settings.image_left.alt | default: 'MB Nutrition' }}"
        loading="eager"
        fetchpriority="high">
    {%- else -%}
      <div class="hero-split__placeholder">Warehouse</div>
    {%- endif -%}

    <div class="hero-split__overlay"></div>

    {%- if section.settings.left_tag != blank or section.settings.left_title != blank -%}
      <div class="hero-split__label">
        {%- if section.settings.left_tag != blank -%}
          <span class="hero-split__tag">{{ section.settings.left_tag }}</span>
        {%- endif -%}
        {%- if section.settings.left_title != blank -%}
          <h2 class="hero-split__title">{{ section.settings.left_title }}</h2>
        {%- endif -%}
        {%- if section.settings.left_cta_label != blank and section.settings.left_cta_url != blank -%}
          <a href="{{ section.settings.left_cta_url }}" class="btn btn--outline-white btn--sm">
            {{ section.settings.left_cta_label }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <!-- Right Panel -->
  <div class="hero-split__panel">
    {%- if section.settings.image_right != blank -%}
      <img
        src="{{ section.settings.image_right | image_url: width: 1000 }}"
        alt="{{ section.settings.image_right.alt | default: 'MB Nutrition' }}"
        loading="eager"
        fetchpriority="high">
    {%- else -%}
      <div class="hero-split__placeholder">Facility</div>
    {%- endif -%}

    <div class="hero-split__overlay"></div>

    {%- if section.settings.right_tag != blank or section.settings.right_title != blank -%}
      <div class="hero-split__label">
        {%- if section.settings.right_tag != blank -%}
          <span class="hero-split__tag">{{ section.settings.right_tag }}</span>
        {%- endif -%}
        {%- if section.settings.right_title != blank -%}
          <h2 class="hero-split__title">{{ section.settings.right_title }}</h2>
        {%- endif -%}
        {%- if section.settings.right_cta_label != blank and section.settings.right_cta_url != blank -%}
          <a href="{{ section.settings.right_cta_url }}" class="btn btn--outline-white btn--sm">
            {{ section.settings.right_cta_label }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

</section>

{% schema %}
{
  "name": "Hero banner (split)",
  "settings": [
    {
      "type": "header",
      "content": "Linker afbeelding"
    },
    {
      "type": "image_picker",
      "id": "image_left",
      "label": "Linker afbeelding"
    },
    {
      "type": "text",
      "id": "left_tag",
      "label": "Tag (klein label)",
      "default": "Nieuw"
    },
    {
      "type": "text",
      "id": "left_title",
      "label": "Titel",
      "default": "MB Nutrition"
    },
    {
      "type": "text",
      "id": "left_cta_label",
      "label": "Knop tekst",
      "default": "Shop nu"
    },
    {
      "type": "url",
      "id": "left_cta_url",
      "label": "Knop link"
    },
    {
      "type": "header",
      "content": "Rechter afbeelding"
    },
    {
      "type": "image_picker",
      "id": "image_right",
      "label": "Rechter afbeelding"
    },
    {
      "type": "text",
      "id": "right_tag",
      "label": "Tag (klein label)",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "right_title",
      "label": "Titel",
      "default": "Shop nu"
    },
    {
      "type": "text",
      "id": "right_cta_label",
      "label": "Knop tekst",
      "default": "Bekijk alles"
    },
    {
      "type": "url",
      "id": "right_cta_url",
      "label": "Knop link"
    }
  ],
  "presets": [
    {
      "name": "Hero banner (split)"
    }
  ]
}
{% endschema %}
