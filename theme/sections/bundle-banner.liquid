<section class="bundle-banner">
  {% if section.settings.image %}
    <div class="bundle-banner__bg">
      <img src="{{ section.settings.image | image_url: width: 1800 }}"
           alt="{{ section.settings.image.alt | default: section.settings.title | escape }}"
           loading="lazy" width="1800" height="700">
    </div>
  {% endif %}
  <div class="bundle-banner__content">
    {% if section.settings.tag != blank %}
      <span class="bundle-banner__tag">{{ section.settings.tag }}</span>
    {% endif %}
    <h2 class="bundle-banner__title">{{ section.settings.title | default: 'Maintenant à prix imbattable' }}</h2>
    {% if section.settings.button_text != blank %}
      <a href="{{ section.settings.button_link | default: '/collections/bundles' }}" class="btn btn--outline-light btn--lg">
        {{ section.settings.button_text }}
      </a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Bannière Bundle",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image de fond"
    },
    {
      "type": "text",
      "id": "tag",
      "label": "Étiquette",
      "default": "BUNDLES"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Maintenant à prix imbattable"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Texte du bouton",
      "default": "Voir tous les bundles"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien du bouton"
    }
  ],
  "presets": [
    { "name": "Bannière Bundle" }
  ]
}
{% endschema %}
