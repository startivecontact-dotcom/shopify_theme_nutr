  <div class="announcement-bar__track" id="AnnouncementTrack">
    <span class="announcement-bar__item">SOLDES</span>
    <span class="announcement-bar__item">LIVRAISON GRATUITE DÈS 80€</span>
    <span class="announcement-bar__item">COMMANDÉ AVANT 23H45 = LIVRÉ DEMAIN</span>
    <span class="announcement-bar__item">PAIEMENT EN 3X SANS FRAIS</span>
    <span class="announcement-bar__item">NOUVELLES RÉFÉRENCES</span>
    <span class="announcement-bar__item">SOLDES</span>
    <span class="announcement-bar__item">LIVRAISON GRATUITE DÈS 80€</span>
    <span class="announcement-bar__item">COMMANDÉ AVANT 23H45 = LIVRÉ DEMAIN</span>
    <span class="announcement-bar__item">PAIEMENT EN 3X SANS FRAIS</span>
    <span class="announcement-bar__item">NOUVELLES RÉFÉRENCES</span>
  </div>
</div>

<header class="site-header" id="SiteHeader" role="banner">
  <div class="container">
    <div class="header__inner">

      <!-- Navigation gauche -->
      <nav class="header__nav-left" aria-label="Navigation principale">
        <ul class="nav__list" role="list">

          <li class="nav__item">
            <a href="{{ routes.root_url }}" class="nav__link">ACCUEIL</a>
          </li>

          <li class="nav__item">
            <a href="{{ routes.collections_url }}" class="nav__link" aria-haspopup="true" aria-expanded="false">
              BOUTIQUE
              <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
                <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
            <div class="nav__mega" role="region" aria-label="Menu boutique">
              <div class="nav__mega-row">
                <div class="nav__mega-col">
                  <h4>Suppléments</h4>
                  <a href="/collections/new" class="is-new">Nouveau : Secret Balance</a>
                  <a href="/collections/secret-burner">Secret Burner</a>
                  <a href="/collections/creatine">Créatine</a>
                  <a href="/collections/pre-workout">Pré-entraînement</a>
                  <a href="/collections/proteines">Protéines</a>
                </div>
                <div class="nav__mega-col">
                  <h4>Populaire</h4>
                  <a href="/collections/new" class="is-new">Nouveau : Secret Balance</a>
                  <a href="/collections/secret-burner">Secret Burner</a>
                  <a href="/collections/pre-workout-m4">Pré-entraînement M4 Extreme</a>
                  <a href="/collections/pre-workout-m3">Pré-entraînement M3</a>
                  <a href="/collections/sleep-shredder">Sleep Shredder</a>
                  <a href="/collections/eaa">EAA</a>
                  <a href="/collections/diet-shake">Diet Shake</a>
                </div>
                <div class="nav__mega-col">
                  <h4>Protéines</h4>
                  <a href="/collections/proteines">Whey Protein Pro</a>
                </div>
                <div class="nav__mega-col">
                  <h4>Extra</h4>
                  <a href="/collections/sauces">Sauce Samurai</a>
                  <a href="/collections/sauces">Sauce Teriyaki</a>
                  <a href="/collections/omega-3">Oméga 3</a>
                  <a href="/collections/cla">CLA</a>
                </div>
                <div class="nav__mega-col">
                  <h4>Packs Avantage</h4>
                  <a href="/collections/packs-avantage">Voir tout</a>
                </div>
              </div>
              <div class="nav__mega-row nav__mega-row--2">
                <div class="nav__mega-col">
                  <h4>Combideals</h4>
                  <a href="/collections/bundles">Voir tout</a>
                </div>
                <div class="nav__mega-col">
                  <h4>Base de connaissances</h4>
                  <a href="/blogs/news">Blog &amp; Articles</a>
                </div>
              </div>
            </div>
          </li>

          <li class="nav__item">
            <a href="/pages/par-objectif" class="nav__link" aria-haspopup="true">
              PAR OBJECTIF
              <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
                <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
            <div class="nav__mega nav__mega--narrow">
              <div class="nav__mega-row nav__mega-row--two">
                <div class="nav__mega-col">
                  <h4>Objectif</h4>
                  <a href="/collections/perte-de-poids">Perte de poids</a>
                  <a href="/collections/prise-de-masse">Prise de masse</a>
                  <a href="/collections/lifestyle">Lifestyle</a>
                  <a href="/collections/endurance">Endurance</a>
                </div>
                <div class="nav__mega-col">
                  <h4>Populaire</h4>
                  <a href="/collections/secret-burner">Secret Burner</a>
                  <a href="/collections/proteines">Whey Protein Pro</a>
                  <a href="/collections/pre-workout">Pré-entraînement M4</a>
                </div>
              </div>
            </div>
          </li>

          <li class="nav__item">
            <a href="/pages/calculateur-calories" class="nav__link">CALCULATEUR CALORIES</a>
          </li>

          <li class="nav__item">
            <a href="/pages/coaching" class="nav__link">COACHING</a>
          </li>

        </ul>
      </nav>

      <!-- Logo central -->
      <div class="header__logo">
        <a href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
          {% if section.settings.logo %}
            <img src="{{ section.settings.logo | image_url: width: 220 }}"
                 alt="{{ shop.name }}"
                 width="{{ section.settings.logo_width | default: 180 }}"
                 height="44"
                 loading="eager">
          {% else %}
            <span class="logo-text">
              <span class="logo-bars">&#x2016;</span>MB NUTRITION<span class="logo-bars">&#x2016;</span>
            </span>
          {% endif %}
        </a>
      </div>

      <!-- Navigation droite -->
      <div class="header__actions header__nav-right">
        <a href="/collections/bundles" class="header__action header__action--text">COMBIDEALS</a>
        <div class="header__divider"></div>
        <span class="header__action header__action--text">EUR | €</span>
        <div class="header__divider"></div>
        <button class="header__action" id="SearchToggle" aria-label="Rechercher">
          <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/><path stroke-linecap="round" d="m21 21-4.35-4.35"/>
          </svg>
        </button>
        <a href="{{ routes.account_url }}" class="header__action" aria-label="Mon compte">
          <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2M12 11a4 4 0 100-8 4 4 0 000 8z"/>
          </svg>
        </a>
        <button class="header__action" id="CartToggle" data-open-cart aria-label="Panier ({{ cart.item_count }} articles)">
          <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4zM3 6h18M16 10a4 4 0 01-8 0"/>
          </svg>
          <span class="cart-count" id="CartCount" {% if cart.item_count == 0 %}style="display:none"{% endif %} aria-live="polite">
            {{ cart.item_count }}
          </span>
        </button>
        <button class="hamburger" id="Hamburger" aria-controls="MobileNav" aria-expanded="false" aria-label="Ouvrir le menu">
          <span class="hamburger__line"></span>
          <span class="hamburger__line"></span>
          <span class="hamburger__line"></span>
        </button>
      </div>

    </div>
  </div>
</header>

<!-- Overlay de recherche -->
<div class="search-overlay" id="SearchOverlay" aria-hidden="true">
  <div class="search-overlay__inner">
    <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true" class="search-overlay__icon">
      <circle cx="11" cy="11" r="8"/><path stroke-linecap="round" d="m21 21-4.35-4.35"/>
    </svg>
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-overlay__form">
      <input type="hidden" name="type" value="product">
      <input type="search" id="SearchInput" name="q" placeholder="Rechercher des produits..." class="search-overlay__input" aria-label="Rechercher" autocomplete="off">
    </form>
    <button id="SearchClose" class="search-overlay__close" aria-label="Fermer">&#x2715;</button>
  </div>
  <div class="search-overlay__results" id="SearchResults" hidden></div>
</div>

<!-- Navigation mobile -->
<nav class="mobile-nav" id="MobileNav" aria-label="Menu mobile" aria-hidden="true">
  <div class="mobile-nav__header">
    <span class="logo-text" style="font-size:1.1rem;">
      <span class="logo-bars">&#x2016;</span>MB NUTRITION<span class="logo-bars">&#x2016;</span>
    </span>
    <button class="mobile-nav__close" id="MobileNavClose" aria-label="Fermer le menu">&#x2715;</button>
  </div>

  <ul>
    <li><a href="{{ routes.root_url }}" class="mobile-nav__link">Accueil</a></li>
    <li>
      <a href="{{ routes.collections_url }}" class="mobile-nav__link" id="MobileShopToggle">
        Boutique <span style="float:right;">&#x203A;</span>
      </a>
      <div class="mobile-nav__sub" id="MobileShopSub" hidden>
        <a href="/collections/new">Nouveau : Secret Balance</a>
        <a href="/collections/secret-burner">Secret Burner</a>
        <a href="/collections/creatine">Créatine</a>
        <a href="/collections/pre-workout">Pré-entraînement</a>
        <a href="/collections/proteines">Protéines</a>
        <a href="/collections/packs-avantage">Packs Avantage</a>
        <a href="/collections/all">Tous les produits</a>
      </div>
    </li>
    <li><a href="/pages/par-objectif" class="mobile-nav__link">Par objectif</a></li>
    <li><a href="/pages/calculateur-calories" class="mobile-nav__link">Calculateur calories</a></li>
    <li><a href="/pages/coaching" class="mobile-nav__link">Coaching</a></li>
    <li><a href="/collections/bundles" class="mobile-nav__link" style="color:var(--color-accent);">Combideals</a></li>
    <li><a href="{{ routes.account_url }}" class="mobile-nav__link">Mon compte</a></li>
    <li><a href="{{ routes.cart_url }}" class="mobile-nav__link">Panier ({{ cart.item_count }})</a></li>
  </ul>
</nav>

{% schema %}
{
  "name": "En-tête",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Image du logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 280,
      "step": 10,
      "unit": "px",
      "label": "Largeur du logo",
      "default": 180
    }
  ]
}
{% endschema %}
