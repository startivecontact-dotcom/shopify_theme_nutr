<!-- Sticky ATC (mobile) -->
<div class="sticky-atc" id="StickyATC" aria-hidden="true">
  <div class="sticky-atc__info">
    <span class="sticky-atc__title">{{ product.title | truncate: 40 }}</span>
    <span class="sticky-atc__price" id="StickyPrice">{{ current_variant.price | money }}</span>
  </div>
  <button class="btn btn--primary sticky-atc__btn" id="StickyATCBtn" {% unless current_variant.available %}disabled{% endunless %}>
    {% if current_variant.available %}Ajouter au panier{% else %}Rupture de stock{% endif %}
  </button>
</div>

<script id="ProductData" type="application/json">
{
  "id": {{ product.id }},
  "options": {{ product.options | json }},
  "variants": [
    {% for v in product.variants %}
    {
      "id": {{ v.id }},
      "available": {{ v.available }},
      "price": {{ v.price }},
      "compare_at_price": {{ v.compare_at_price | default: 0 }},
      "options": {{ v.options | json }}
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}
</script>

<script>
(function() {
  // Countdown timer
  var timerEl = document.querySelector('[data-countdown]');
  if (timerEl) {
    var end = new Date();
    end.setHours(23, 45, 0, 0);
    if (end < new Date()) end.setDate(end.getDate() + 1);
    function tick() {
      var diff = end - new Date();
      if (diff <= 0) { timerEl.textContent = '00:00:00'; return; }
      var h = Math.floor(diff / 3600000);
      var m = Math.floor((diff % 3600000) / 60000);
      var s = Math.floor((diff % 60000) / 1000);
      timerEl.textContent = String(h).padStart(2,'0') + ':' + String(m).padStart(2,'0') + ':' + String(s).padStart(2,'0');
    }
    tick();
    setInterval(tick, 1000);
  }

  // Sticky ATC
  var atcBtn = document.getElementById('ProductATC');
  var stickyAtc = document.getElementById('StickyATC');
  var stickyBtn = document.getElementById('StickyATCBtn');
  if (atcBtn && stickyAtc) {
    var observer = new IntersectionObserver(function(entries) {
      var visible = entries[0].isIntersecting;
      stickyAtc.classList.toggle('is-visible', !visible);
      stickyAtc.setAttribute('aria-hidden', visible ? 'true' : 'false');
    }, { threshold: 0.1 });
    observer.observe(atcBtn);
    if (stickyBtn) {
      stickyBtn.addEventListener('click', function() {
        atcBtn.click();
      });
    }
  }

  // FBT total calculator
  var fbtCheckboxes = document.querySelectorAll('.fbt-checkbox');
  var fbtTotalEl = document.getElementById('FbtTotal');
  var fbtAddAll = document.getElementById('FbtAddAll');
  var mainProductPrice = {{ current_variant.price }};

  function updateFbtTotal() {
    var total = mainProductPrice;
    fbtCheckboxes.forEach(function(cb) {
      if (cb.checked) {
        var id = cb.getAttribute('data-product-id');
        // prices are encoded in data attribute for simplicity
        var priceEl = cb.closest('.fbt-card').querySelector('.fbt-card__price');
        if (priceEl && priceEl.dataset.cents) total += parseInt(priceEl.dataset.cents);
      }
    });
    if (fbtTotalEl) {
      fbtTotalEl.textContent = (total / 100).toFixed(2).replace('.', ',') + ' €';
    }
  }

  fbtCheckboxes.forEach(function(cb) {
    cb.addEventListener('change', updateFbtTotal);
  });

  if (fbtAddAll) {
    fbtAddAll.addEventListener('click', function() {
      var items = [{ id: document.getElementById('VariantId').value, quantity: 1 }];
      fbtCheckboxes.forEach(function(cb) {
        if (cb.checked) items.push({ id: cb.getAttribute('data-product-id'), quantity: 1 });
      });
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: items })
      }).then(function() {
        if (window.theme && window.theme.openCart) window.theme.openCart();
        else window.location.href = '/cart';
      });
    });
  }
})();
</script>

{% schema %}
{
  "name": "Produit principal",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Affichage" },
    { "type": "checkbox", "id": "show_vendor", "label": "Afficher le fournisseur", "default": true },
    { "type": "checkbox", "id": "show_rating", "label": "Afficher la note", "default": true },
    { "type": "number", "id": "review_count", "label": "Nombre d'avis affiché", "default": 124 },
    { "type": "checkbox", "id": "show_trust_badges", "label": "Afficher les badges de confiance", "default": true },
    { "type": "checkbox", "id": "show_urgency", "label": "Afficher le badge urgence", "default": true },
    { "type": "checkbox", "id": "show_countdown", "label": "Afficher le compte à rebours", "default": true },
    { "type": "checkbox", "id": "show_stock", "label": "Afficher l'indicateur de stock", "default": true },
    { "type": "number", "id": "stock_count", "label": "Quantité en stock affichée", "default": 12 },
    { "type": "number", "id": "buyers_today", "label": "Acheteurs aujourd'hui (social proof)", "default": 23 },
    { "type": "header", "content": "Onglet Utilisation" },
    { "type": "textarea", "id": "usage_text", "label": "Texte « Utilisation »", "default": "Mélangez 1 dose avec 250 ml d'eau froide." },
    { "type": "header", "content": "Produits complémentaires (FBT)" },
    { "type": "checkbox", "id": "show_fbt", "label": "Afficher «Fréquemment achetés ensemble»", "default": true },
    { "type": "text", "id": "fbt_heading", "label": "Titre FBT", "default": "Fréquemment achetés ensemble" },
    { "type": "product", "id": "fbt_product_1", "label": "Produit complémentaire 1" },
    { "type": "product", "id": "fbt_product_2", "label": "Produit complémentaire 2" },
    { "type": "text", "id": "fbt_savings_label", "label": "Message économies FBT", "default": "🎁 Économisez 10% en commandant les 3 !" },
    { "type": "header", "content": "Produits recommandés" },
    { "type": "checkbox", "id": "show_recommendations", "label": "Afficher les recommandations", "default": true },
    { "type": "text", "id": "rec_heading", "label": "Titre recommandations", "default": "Complétez votre routine" },
    { "type": "collection", "id": "rec_collection", "label": "Collection à afficher" },
    { "type": "header", "content": "Avis clients" },
    { "type": "checkbox", "id": "show_reviews", "label": "Afficher les avis", "default": true },
    { "type": "text", "id": "review_1_title", "label": "Titre avis 1", "default": "Excellent produit !" },
