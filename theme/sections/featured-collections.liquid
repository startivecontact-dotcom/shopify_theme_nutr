{% comment %}
  MB Nutrition — Shop By Goal Section
  2x2 grid with b&w images and text overlay
  Goals: Afvallen | Spieropbouw | Lifestyle | Stamina
{% endcomment %}

<section class="shop-goal" id="shop-op-doel" aria-labelledby="goal-title">
  <div class="container">
    <div class="shop-goal__header">
      <p class="shop-goal__label">{{ section.settings.label | default: 'SHOP OP DOEL' }}</p>
      <h2 class="shop-goal__title" id="goal-title">{{ section.settings.heading | default: 'WAT IS JOUW DOEL?' }}</h2>
    </div>
  </div>

  <div class="shop-goal__grid">

    {%- for block in section.blocks -%}
      {%- if block.type == 'goal' -%}
        <a
          href="{{ block.settings.link | default: '#' }}"
          class="goal-cell"
          {{ block.shopify_attributes }}>

          {%- if block.settings.image != blank -%}
            <img
              src="{{ block.settings.image | image_url: width: 800 }}"
              alt="{{ block.settings.title }}"
              loading="lazy">
          {%- else -%}
            <div class="goal-cell__placeholder"></div>
          {%- endif -%}

          <div class="goal-cell__overlay" aria-hidden="true"></div>

          <div class="goal-cell__content">
            <h3 class="goal-cell__title">{{ block.settings.title }}</h3>
            <span class="goal-cell__btn">{{ block.settings.cta | default: 'Shop nu' }}</span>
          </div>
        </a>
      {%- endif -%}
    {%- endfor -%}

    {%- if section.blocks.size == 0 -%}
      <!-- Default cells when no blocks configured -->
      <a href="/collections/afvallen" class="goal-cell">
        <div class="goal-cell__placeholder"></div>
        <div class="goal-cell__overlay"></div>
        <div class="goal-cell__content">
          <h3 class="goal-cell__title">Afvallen</h3>
          <span class="goal-cell__btn">Shop nu</span>
        </div>
      </a>
      <a href="/collections/spieropbouw" class="goal-cell">
        <div class="goal-cell__placeholder"></div>
        <div class="goal-cell__overlay"></div>
        <div class="goal-cell__content">
          <h3 class="goal-cell__title">Spieropbouw</h3>
          <span class="goal-cell__btn">Shop nu</span>
        </div>
      </a>
      <a href="/collections/lifestyle" class="goal-cell">
        <div class="goal-cell__placeholder"></div>
        <div class="goal-cell__overlay"></div>
        <div class="goal-cell__content">
          <h3 class="goal-cell__title">Lifestyle</h3>
          <span class="goal-cell__btn">Shop nu</span>
        </div>
      </a>
      <a href="/collections/stamina" class="goal-cell">
        <div class="goal-cell__placeholder"></div>
        <div class="goal-cell__overlay"></div>
        <div class="goal-cell__content">
          <h3 class="goal-cell__title">Stamina</h3>
          <span class="goal-cell__btn">Shop nu</span>
        </div>
      </a>
    {%- endif -%}

  </div><!-- /.shop-goal__grid -->
</section>

{% schema %}
{
  "name": "Shop op doel",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Klein label",
      "default": "SHOP OP DOEL"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Koptekst",
      "default": "WAT IS JOUW DOEL?"
    }
  ],
  "blocks": [
    {
      "type": "goal",
      "name": "Doel cel",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Afbeelding (wordt zwart-wit)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titel",
          "default": "Afvallen"
        },
        {
          "type": "text",
          "id": "cta",
          "label": "Knoptekst",
          "default": "Shop nu"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop op doel",
      "blocks": [
        {
          "type": "goal",
          "settings": {
            "title": "Afvallen",
            "cta": "Shop nu",
            "link": "/collections/afvallen"
          }
        },
        {
          "type": "goal",
          "settings": {
            "title": "Spieropbouw",
            "cta": "Shop nu",
            "link": "/collections/spieropbouw"
          }
        },
        {
          "type": "goal",
          "settings": {
            "title": "Lifestyle",
            "cta": "Shop nu",
            "link": "/collections/lifestyle"
          }
        },
        {
          "type": "goal",
          "settings": {
            "title": "Stamina",
            "cta": "Shop nu",
            "link": "/collections/stamina"
          }
        }
      ]
    }
  ]
}
{% endschema %}
