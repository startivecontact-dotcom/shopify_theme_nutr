{% if section.settings.show_announcement %}
<div class="announcement-bar" id="AnnouncementBar" role="banner" aria-label="Promotions">
  <div class="container">
    <div class="announcement-bar__content">
      {% if section.settings.text_1 != blank %}
        <span class="announcement-bar__item">{{ section.settings.text_1 }}</span>
      {% endif %}
      {% if section.settings.text_2 != blank %}
        <span class="announcement-bar__item" style="opacity:0.5">|</span>
        <span class="announcement-bar__item">{{ section.settings.text_2 }}</span>
      {% endif %}
      {% if section.settings.text_3 != blank %}
        <span class="announcement-bar__item" style="opacity:0.5">|</span>
        <span class="announcement-bar__item">{{ section.settings.text_3 }}</span>
      {% endif %}
    </div>
  </div>
  {% if section.settings.show_close %}
    <button class="announcement-bar__close" id="AnnouncementClose" aria-label="Fermer">&#x2715;</button>
  {% endif %}
</div>
{% endif %}

{% schema %}
{
  "name": "Barre d'annonce",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Afficher la barre d'annonce",
      "default": true
    },
    {
      "type": "text",
      "id": "text_1",
      "label": "Message 1",
      "default": "🚚 LIVRAISON GRATUITE dès 60€"
    },
    {
      "type": "text",
      "id": "text_2",
      "label": "Message 2",
      "default": "💪 -10% avec le code BIENVENUE"
    },
    {
      "type": "text",
      "id": "text_3",
      "label": "Message 3",
      "default": "⭐ +5000 clients satisfaits"
    },
    {
      "type": "checkbox",
      "id": "show_close",
      "label": "Afficher le bouton fermer",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Barre d'annonce"
    }
  ]
}
{% endschema %}
