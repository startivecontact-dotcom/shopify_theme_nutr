      <script>
        // Helper function to ensure button text override works correctly
        document.addEventListener("DOMContentLoaded", function() {
          // Watch for cart update events
          document.addEventListener('cart:update', function() {
            setTimeout(restorePersistentButtonText, 50);
          });
          
          // Watch for section renders in theme editor
          document.addEventListener('shopify:section:load', restorePersistentButtonText);
          
          // Watch for variant changes
          document.addEventListener('variant:change', restorePersistentButtonText);
          
          function restorePersistentButtonText() {
            // First process buttons with text-override attribute
            const overrideButtons = document.querySelectorAll('.shop-add-to-cart-button[data-text-override="true"]');
            overrideButtons.forEach(button => {
              const buttonTextElement = button.querySelector('.button-text');
              if (buttonTextElement && button.dataset.persistentText) {
                buttonTextElement.textContent = button.dataset.persistentText;
              }
            });
            
            // Then handle any remaining persistent text buttons
            const persistentButtons = document.querySelectorAll('.shop-add-to-cart-button.has-persistent-text:not([data-text-override="true"])');
            persistentButtons.forEach(button => {
              const buttonTextElement = button.querySelector('.button-text');
              if (buttonTextElement) {
                const persistentText = button.dataset.persistentText || localStorage.getItem('addToCartButtonText');
                if (persistentText) {
                  buttonTextElement.textContent = persistentText;
                }
              }
            });
          }
          
          // Initial run
          restorePersistentButtonText();
        });
      </script>

