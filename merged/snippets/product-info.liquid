          }
        }

        @media screen and (max-width: 480px) {

          #product-faq-{{ block.id }} .faq-question {
            padding: {{ question_padding | minus: 2 }}px {{ question_padding | times: 1.2 }}px;
            font-size: {{ text_size | minus: 2 }}px;
          }

          #product-faq-{{ block.id }} .faq-question-image {
            width: {{ image_size | times: 0.8 }}px;
            height: {{ image_size | times: 0.8 }}px;
          }

          #product-faq-{{ block.id }} .faq-toggle {
            font-size: {{ text_size | minus: 1 }}px;
          }

          #product-faq-{{ block.id }} .faq-answer {
            padding: 0 {{ question_padding | times: 1.2 }}px;
            font-size: {{ answer_text_size | minus: 2 }}px;
          }

          #product-faq-{{ block.id }} .faq-item.active .faq-answer {
            padding: {{ item_padding }}px {{ question_padding | times: 1.2 }}px {{ item_padding | plus: 2 }}px;
          }
        }
      </style>

