{% comment %}
  Horizontal Scrolling Ticker Section
  - Responsive: 38px height on mobile, 60px height on desktop (25% smaller)
  - Customizable messages, colors, and scroll speed
  - Properly centered dividers between text items
  - CSS animation for continuous scrolling with seamless infinite loop
{% endcomment %}

<div class="ticker-wrapper" style="background-color: {{ section.settings.background_color }}; --ticker-font-weight: {{ section.settings.font_weight }};">
  <div class="ticker">
    <div class="ticker__track" style="animation-duration: {{ 130 | minus: section.settings.scroll_speed }}s;">
      {% comment %} Create multiple copies for a smoother infinite loop {% endcomment %}
      {% for i in (1..3) %}
        <div class="ticker__content">
          {% for block in section.blocks %}
            {% if block.type == 'announcement' %}
              <div class="ticker__item" {{ block.shopify_attributes }}>
                <span style="color: {{ section.settings.text_color }};">{{ block.settings.text }}</span>
              </div>
              {% unless forloop.last == true and i == 3 %}
                {% if section.settings.show_dividers %}
                  <div class="ticker__divider">
                    {% if section.settings.divider_type == 'text' %}
                      <span style="color: {{ section.settings.text_color }};">{{ section.settings.divider_text }}</span>
                    {% elsif section.settings.divider_type == 'image' and section.settings.divider_image != blank %}
                      <img src="{{ section.settings.divider_image | img_url: '40x' }}" 
                           alt="Divider" 
                           style="width: {{ section.settings.divider_size }}px; height: auto;" 
                           loading="lazy">
                    {% else %}
                    <span style="color: {{ section.settings.text_color }};">+</span>
                    {% endif %}
                  </div>
                {% endif %}
              {% endunless %}
            {% endif %}
          {% endfor %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<style>
  .ticker-wrapper {
    width: 100%;
    overflow: hidden;
    height: 38px; /* Mobile height (25% smaller than 50px) */
    display: flex;
    align-items: center;
  }
  
  .ticker {
    width: 100%;
    overflow: hidden;
    position: relative;
  }
  
  .ticker__track {
    display: flex;
    animation: ticker-scroll linear infinite;
    will-change: transform;
  }
  
  .ticker__content {
    display: flex;
    white-space: nowrap;
    align-items: center;
    flex-shrink: 0; /* Prevent content from shrinking */
  }
  
  .ticker__item {
    display: flex;
    align-items: center;
    padding: 0 15px;
    font-weight: var(--ticker-font-weight) !important;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
    font-size: 0.9em;
  }
  
  .ticker__divider {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1em;
    padding: 0 5px;
  }
  
  .ticker__divider img {
    display: block;
    max-height: 20px;
  }
  
  @keyframes ticker-scroll {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-33.333%, 0, 0); /* Adjusted for 3 copies */
    }
  }
  
  /* Desktop styles */
  @media screen and (min-width: 768px) {
    .ticker-wrapper {
      height: 60px; /* Desktop height (25% smaller than 80px) */
    }
    
    .ticker__item {
      font-size: 1em;
      padding: 0 22px;
    }
    
    .ticker__divider {
      font-size: 1.1em;
    }
    
    .ticker__divider img {
      max-height: 25px;
    }
  }
</style>

{% schema %}
{
  "name": "Scrolling Ticker",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Text Font Weight",
      "options": [
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semibold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "600"
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "min": 10,
      "max": 120,
      "step": 5,
      "unit": "sp",
      "label": "Scroll Speed (lower = faster)",
      "default": 30
    },
    {
      "type": "header",
      "content": "Divider Settings"
    },
    {
      "type": "checkbox",
      "id": "show_dividers",
      "label": "Show dividers between items",
      "default": true
    },
    {
      "type": "select",
      "id": "divider_type",
      "label": "Divider Type",
      "options": [
        {
          "value": "text",
          "label": "Text"
        },
        {
          "value": "image",
          "label": "Image"
        }
      ],
      "default": "text"
    },
    {
      "type": "text",
      "id": "divider_text",
      "label": "Divider Text",
      "default": "+",
      "info": "Used when divider type is set to 'Text'"
    },
    {
      "type": "image_picker",
      "id": "divider_image",
      "label": "Divider Image",
      "info": "Used when divider type is set to 'Image'"
    },
    {
      "type": "range",
      "id": "divider_size",
      "min": 10,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Image Size",
      "default": 16,
      "info": "Sets the width of the divider image"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Announcement text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Scrolling Ticker",
      "blocks": [
        {
          "type": "announcement",
          "settings": {
            "text": "FREE SHIPPING"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "ON SALE NOW"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "SPRING SALE"
          }
        }
      ]
    }
  ]
}
{% endschema %}