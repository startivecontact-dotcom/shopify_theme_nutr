      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#EF4A65"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color",
      "default": "#EEEEEE"
    },
    {
      "type": "checkbox",
      "id": "show_product_info",
      "label": "Show product information",
      "default": true
