<section class="mb-cat-products page-width">
  <div class="mb-cat-header">
    <div>
      {% if section.settings.eyebrow != blank %}
        <p class="mb-cat-header__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h2 class="mb-cat-header__title">{{ section.settings.title }}</h2>
      {% if section.settings.description != blank %}
        <p class="mb-cat-header__desc">{{ section.settings.description }}</p>
      {% endif %}
    </div>
    {% if section.settings.view_all_link != blank %}
      <a href="{{ section.settings.view_all_link }}">Voir tout &rarr;</a>
    {% endif %}
  </div>

  <div class="mb-cat-grid">
    {% for block in section.blocks %}
      {% assign p = all_products[block.settings.product_handle] %}
      {% if p and p != empty %}
        <div class="mb-product-card">
          <a href="{{ p.url }}" class="mb-product-card__full-link" aria-label="{{ p.title | escape }}"></a>
          <a href="{{ p.url }}" class="mb-product-card__image-wrap" tabindex="-1" aria-hidden="true">
            {% if p.featured_image %}
              <img src="{{ p.featured_image | image_url: width: 600 }}" alt="{{ p.title | escape }}" loading="lazy" width="600" height="600">
            {% endif %}
            {% if p.available == false %}<span class="mb-product-card__badge" style="background:#999">Épuisé</span>
            {% elsif p.compare_at_price > p.price %}<span class="mb-product-card__badge">Soldes</span>{% endif %}
          </a>
          <div class="mb-product-card__body">
            <h3 class="mb-product-card__title"><a href="{{ p.url }}">{{ p.title | upcase }}</a></h3>
            <div class="mb-product-card__price {% if p.compare_at_price > p.price %}mb-product-card__price--sale{% endif %}">
              {{ p.price | money }}{% if p.compare_at_price > p.price %}<s>{{ p.compare_at_price | money }}</s>{% endif %}
            </div>
            {% if p.available %}
              <button class="mb-product-card__atc" data-product-id="{{ p.variants.first.id }}" onclick="event.preventDefault();event.stopPropagation();fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:'{{ p.variants.first.id }}',quantity:1})}).then(function(){window.location.href='/cart'})">Ajouter au panier</button>
            {% else %}
              <button class="mb-product-card__atc" disabled style="background:#ccc;cursor:not-allowed">Rupture de stock</button>
            {% endif %}
          </div>
        </div>
      {% elsif block.settings.product_image_url != blank %}
        {% assign card_url = block.settings.product_url | default: '/collections/all' %}
        <div class="mb-product-card" {{ block.shopify_attributes }}>
          <a href="{{ card_url }}" class="mb-product-card__full-link" aria-label="{{ block.settings.product_title | escape }}"></a>
          <a href="{{ card_url }}" class="mb-product-card__image-wrap" tabindex="-1" aria-hidden="true">
            <img src="{{ block.settings.product_image_url }}" alt="{{ block.settings.product_title | escape }}" loading="lazy" width="600" height="600">
            {% if block.settings.product_badge != blank %}
              <span class="mb-product-card__badge {% if block.settings.product_badge == 'NOUVEAU' %}mb-product-card__badge--new{% endif %}">{{ block.settings.product_badge }}</span>
            {% endif %}
          </a>
          <div class="mb-product-card__body">
            <h3 class="mb-product-card__title"><a href="{{ card_url }}">{{ block.settings.product_title | upcase }}</a></h3>
            <div class="mb-product-card__price {% if block.settings.product_compare_price != blank %}mb-product-card__price--sale{% endif %}">
              {{ block.settings.product_price }}{% if block.settings.product_compare_price != blank %}<s>{{ block.settings.product_compare_price }}</s>{% endif %}
            </div>
            <a href="{{ card_url }}" class="mb-product-card__atc" style="position:relative;z-index:2">Voir le produit &rarr;</a>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "MB — Produits par catégorie",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Étiquette" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Perte de poids" },
    { "type": "text", "id": "description", "label": "Description" },
    { "type": "url", "id": "view_all_link", "label": "Lien voir tout" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Produit",
      "settings": [
        { "type": "text", "id": "product_handle", "label": "Handle Shopify" },
        { "type": "text", "id": "product_title", "label": "Nom" },
        { "type": "text", "id": "product_price", "label": "Prix", "default": "29,95 €" },
        { "type": "text", "id": "product_compare_price", "label": "Prix barré" },
        { "type": "text", "id": "product_badge", "label": "Badge" },
        { "type": "text", "id": "product_image_url", "label": "URL image CDN" },
        { "type": "url", "id": "product_url", "label": "Lien produit" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "MB — Produits par catégorie" }]
}
{% endschema %}
