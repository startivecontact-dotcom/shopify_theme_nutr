<div class="custom-benefits-section-wrapper">
  <div class="custom-benefits-section">
    <div class="custom-benefits-container">
      <div class="custom-content-column">
        <div class="custom-section-header">
          {% if section.settings.heading_accent != blank %}
            <h2 class="custom-main-heading">
              {{ section.settings.heading_regular }} 
              <span class="{% if section.settings.override_global_accent %}custom-accent-text{% else %}global-accent-text{% endif %}">
                {{ section.settings.heading_accent }}
              </span>
            </h2>
          {% else %}
            <h2 class="custom-main-heading">{{ section.settings.heading_regular }}</h2>
          {% endif %}
          
          {% if section.settings.subtitle != blank %}
            <div class="custom-subtitle">{{ section.settings.subtitle }}</div>
          {% endif %}
        </div>
      </div>
      
      <div class="custom-image-column">
        {% if section.settings.show_image %}
          <div class="custom-section-image-container">
            {% if section.settings.feature_image != blank %}
              <div class="custom-feature-image">
                <img src="{{ section.settings.feature_image | img_url: 'master' }}" alt="{{ section.settings.image_alt | escape }}">
              </div>
            {% else %}
              <div class="custom-placeholder-image">
                {{ 'image' | placeholder_svg_tag: 'custom-placeholder-svg' }}
              </div>
            {% endif %}
          </div>
        {% endif %}
      </div>

      <div class="custom-benefits-column">
        <div class="custom-benefits-list">
          {% for block in section.blocks %}
            {% if block.type == 'benefit' %}
              <div class="custom-benefit-item" {{ block.shopify_attributes }}>
                <div class="custom-benefit-header">
                  <div class="custom-benefit-icon" style="color: {% if section.settings.use_theme_colors %}{{ settings.global_section_accent_1_color }}{% else %}{{ block.settings.benefit_color | default: section.settings.accent_color }}{% endif %};">
                    {% if block.settings.use_image and block.settings.icon_image != blank %}
                      <img src="{{ block.settings.icon_image | img_url: '50x' }}" alt="{{ block.settings.title | escape }}" class="custom-icon-image">
                    {% elsif block.settings.use_custom_icon and block.settings.custom_icon_svg != blank %}
                      {{ block.settings.custom_icon_svg }}
                    {% else %}
                      {% case block.settings.preset_icon %}
                        {% when 'check' %}
                          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                          </svg>
                        {% when 'clock' %}
                          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8z"/>
                            <path d="M12.5 7H11v6l5.25 3.15.75-1.23-4.5-2.67z"/>
                          </svg>
                        {% when 'sparkle' %}
                          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12 1L9 9l-8 3 8 3 3 8 3-8 8-3-8-3-3-8z"/>
                          </svg>
                        {% when 'heart' %}
                          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                          </svg>
                      {% endcase %}
                    {% endif %}
                  </div>
                  <h3 class="custom-benefit-title" style="color: {% if section.settings.use_theme_colors %}{{ settings.global_section_accent_1_color }}{% else %}{{ block.settings.benefit_color | default: section.settings.accent_color }}{% endif %};">{{ block.settings.title }}</h3>
                </div>
                <div class="custom-benefit-description-container">
                  <p class="custom-benefit-description" style="color: {% if section.settings.use_theme_colors %}{{ settings.global_section_text_color }}{% else %}{{ block.settings.benefit_description_color | default: section.settings.description_color }}{% endif %};">
                    {{ block.settings.description }}
                  </p>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* Style isolation */
  .custom-benefits-section-wrapper,
  .custom-benefits-section-wrapper * {
    box-sizing: border-box;
  }
  
  .custom-benefits-section-wrapper {
    display: block;
    width: 100%;
    overflow: hidden;
    {% if section.settings.use_theme_colors %}
      {% if settings.global_section_use_gradient_background %}
        background: linear-gradient(to right, {{ settings.global_section_gradient_color_1 }}, {{ settings.global_section_gradient_color_2 }});
      {% else %}
        background-color: {{ settings.global_section_background_color }};
      {% endif %}
    {% elsif section.settings.use_gradient %}
      background: linear-gradient({{ section.settings.gradient_angle }}deg, {{ section.settings.gradient_start_color }} 0%, {{ section.settings.gradient_end_color }} 100%);
    {% else %}
      background-color: {{ section.settings.background_color }};
    {% endif %}
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .custom-benefits-section {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 25px;
    width: 100%;
    display: block;
  }

  .global-accent-text {
    color: {% if section.settings.use_theme_colors %}{{ settings.global_section_accent_1_color }}{% else %}{{ section.settings.accent_color }}{% endif %};
    font-style: {{ settings.accent_text_style }};
    font-family: {{ settings.accent_text_font.family }}, {{ settings.accent_text_font.fallback_families }};
    font-weight: {{ settings.accent_text_weight }};
  }

  .custom-accent-text {
    color: {% if section.settings.use_theme_colors %}{{ settings.global_section_accent_1_color }}{% else %}{{ section.settings.accent_color }}{% endif %};
    font-style: {{ section.settings.accent_text_style }};
    font-family: {{ section.settings.accent_font_family.family }}, {{ section.settings.accent_font_family.fallback_families }};
    font-weight: {{ section.settings.accent_text_weight }};
  }

  .custom-feature-image {
    width: 100%;
    height: 0;
    padding-bottom: 100%; /* Square aspect ratio */
    position: relative;
    border-radius: 8px;
    overflow: hidden;
  }

  .custom-feature-image img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 8px;
  }

  .custom-placeholder-image {
    width: 100%;
    height: 0;
    padding-bottom: 100%; /* Square aspect ratio */
    margin: 0 auto;
    background-color: #f5f5f5;
    border-radius: 8px;
    position: relative;
    overflow: hidden;
  }

  .custom-placeholder-svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    fill: #d0d0d0;
  }

  .custom-benefit-item {
    margin-bottom: 25px;
  }

  .custom-benefit-item:last-child {
    margin-bottom: 0;
  }

  .custom-benefit-header {
    display: flex;
    align-items: center;
    margin-bottom: 5px;
  }

  .custom-benefit-icon {
    margin-right: 10px;
    flex-shrink: 0;
    width: 24px;
    height: 24px;
  }

  .custom-benefit-icon svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  .custom-benefit-title {
    font-size: {{ section.settings.benefit_title_size_mobile }}px;
    font-weight: var(--font-weight-semibold);
    margin: 0;
    letter-spacing: var(--letter-spacing-body);
  }

  .custom-benefit-description-container {
    padding-left: 0;
  }

  .custom-benefit-description {
    font-size: {{ section.settings.benefit_description_size_mobile }}px;
    line-height: 1.5;
    font-weight: var(--font-weight-regular);
    margin: 0;
    letter-spacing: var(--letter-spacing-body);
  }

  /* Mobile styles (default) */
  .custom-benefits-container {
    display: flex;
    flex-direction: column;
  }
  
  .custom-content-column {
    order: 1; /* Show header first on mobile */
  }
  
  .custom-image-column {
    order: 2; /* Show image second on mobile */
  }
  
  .custom-benefits-column {
    order: 3; /* Show benefits last on mobile */
  }
  
  .custom-section-header {
    text-align: center;
    margin-bottom: 20px;
    padding-top: 10px;
  }
  
  .custom-main-heading {
    font-size: {{ section.settings.heading_size_mobile }}px;
    line-height: 1.1;
    font-weight: var(--font-weight-bold);
    margin-top: 0px;
    color: {% if section.settings.use_theme_colors %}{{ settings.global_section_text_color }}{% else %}{{ section.settings.heading_color }}{% endif %};
    margin-bottom: 12px;
    letter-spacing: var(--letter-spacing-heading);
  }
  
  .custom-subtitle {
    font-size: {{ section.settings.subtitle_size_mobile }}px;
    line-height: 1.5;
    font-weight: var(--font-weight-regular);
    color: {% if section.settings.use_theme_colors %}{{ settings.global_section_text_color }}{% else %}{{ section.settings.subtitle_color }}{% endif %};
    margin: 0 0 10px;
    letter-spacing: var(--letter-spacing-body);
    max-width: 450px;
    margin-left: auto;
    margin-right: auto;
  }
  
  .custom-section-image-container {
    max-width: 320px;
    margin: 0 auto 25px;
  }
  
  .custom-benefits-list {
    background-color: {{ section.settings.list_background_color }};
    border-radius: {{ section.settings.list_border_radius }}px;
    padding: 20px;
    max-width: 450px;
    margin: 0 auto;
    border: 1px solid {{ section.settings.border_color }};
  }

  /* Desktop styles */
  @media screen and (min-width: 768px) {
    .custom-benefits-section {
      padding: 50px 30px; /* Added 50px top/bottom padding for desktop */
    }
    
    .custom-benefits-container {
      display: grid;
      grid-template-columns: 45% 55%;
      grid-template-areas: 
        "image header"
        "image benefits";
      gap: 0px 30px;
      align-items: center;
    }
    
    .custom-content-column {
      grid-area: header;
      align-self: start;
    }
    
    .custom-image-column {
      grid-area: image;
    }
    
    .custom-benefits-column {
      grid-area: benefits;
    }
    
    .custom-section-header {
      text-align: center;
      margin-bottom: 20px;
      width: 100%;
      max-width: 450px;
      margin-left: auto;
      margin-right: auto;
      padding-top: 0;
    }
    
    .custom-main-heading {
      font-size: {{ section.settings.heading_size_desktop }}px;
      margin-bottom: 10px;
    }
    
    .custom-subtitle {
      font-size: {{ section.settings.subtitle_size_desktop }}px;
      font-weight: var(--font-weight-regular);
      margin-left: auto;
      margin-right: auto;
    }
    
    .custom-section-image-container {
      max-width: 100%;
      margin: 0;
    }
    
    .custom-benefits-list {
      margin: 0 auto;
      width: 100%;
      max-width: 450px;
      padding: 30px;
    }
    
    .custom-benefit-title {
      font-size: {{ section.settings.benefit_title_size_desktop }}px;
    }
    
    .custom-benefit-description {
      font-size: {{ section.settings.benefit_description_size_desktop }}px;
    }
  }

  .custom-icon-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
</style>

{% schema %}
{
