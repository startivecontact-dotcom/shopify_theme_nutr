      "unit": "px",
      "label": "Benefit Description Size (Mobile)",
      "default": 12
    },
    {
      "type": "range",
      "id": "benefit_description_size_desktop",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Benefit Description Size (Desktop)",
      "default": 12
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Default Accent Color",
      "default": "#EF4A65",
      "info": "Default color for benefit icons and titles if not set individually."
    },
    {
      "type": "font_picker",
      "id": "accent_font_family",
      "label": "Accent Text Font",
      "default": "helvetica_n4"
    },
    {
      "type": "select",
      "id": "accent_text_style",
      "label": "Accent Text Style",
      "options": [
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "italic",
          "label": "Italic"
        }
      ],
      "default": "normal"
    },
    {
      "type": "select",
      "id": "accent_text_weight",
      "label": "Accent Text Weight",
