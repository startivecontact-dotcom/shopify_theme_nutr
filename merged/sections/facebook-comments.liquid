{% comment %}
  Facebook Reviews Section
  A customizable section that displays reviews in a Facebook-style layout
{% endcomment %}

<section class="facebook-reviews-section" 
         id="facebook-reviews-{{ section.id }}" 
         style="background-color: {{ section.settings.background_color }}">
  {% if section.settings.title != blank %}
    <div class="title-container">
      <h2 class="reviews-title" style="color: {{ section.settings.title_color }}">
        {{ section.settings.title | replace: 'Facebook', '' }}
      </h2>
      <div class="facebook-views-badge">
        <svg class="facebook-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" fill="white"/>
        </svg>
        <span class="facebook-text">Recently viral on Facebook</span>
      </div>
    </div>
  {% endif %}
  
  <div class="reviews-container">
    <div class="reviews-grid">
      <!-- Column 1 -->
      <div class="reviews-column">
        {% for block in section.blocks %}
          {% assign modulo = forloop.index | modulo: 3 %}
          {% if modulo == 1 %}
            {% if block.type == 'review' %}
              <div class="review-item" {{ block.shopify_attributes }}>
                <div class="profile-pic">
                  {% if block.settings.profile_image != blank %}
                    <img src="{{ block.settings.profile_image | img_url: '100x100', crop: 'center' }}" alt="{{ block.settings.name }}">
                  {% else %}
                    <img src="{{ 'user-placeholder.png' | asset_url }}" alt="Profile Picture">
                  {% endif %}
                </div>
                <div class="review-content-wrapper">
                  <div class="review-card" style="background-color: {{ section.settings.comment_background }}">
                    <div class="reviewer-name" style="color: {{ section.settings.name_color }}">{{ block.settings.name }}</div>
                    <p class="review-content" style="color: {{ section.settings.text_color }}">{{ block.settings.comment }}</p>
                  </div>
                  <div class="review-meta">
                    <div class="review-actions">
                      <span class="review-action" style="color: {{ section.settings.action_color }}">{{ section.settings.like_text }}</span>
                      <span class="review-action" style="color: {{ section.settings.action_color }}">{{ section.settings.reply_text }}</span>
                    </div>
                    <div class="review-time" style="color: {{ section.settings.date_color }}">{{ block.settings.date }}</div>
                  </div>
                </div>
              </div>
            {% endif %}
          {% endif %}
        {% endfor %}
      </div>
      
      <!-- Column 2 -->
      <div class="reviews-column">
        {% for block in section.blocks %}
          {% assign modulo = forloop.index | modulo: 3 %}
          {% if modulo == 2 %}
            {% if block.type == 'review' %}
              <div class="review-item" {{ block.shopify_attributes }}>
                <div class="profile-pic">
                  {% if block.settings.profile_image != blank %}
                    <img src="{{ block.settings.profile_image | img_url: '100x100', crop: 'center' }}" alt="{{ block.settings.name }}">
                  {% else %}
                    <img src="{{ 'user-placeholder.png' | asset_url }}" alt="Profile Picture">
                  {% endif %}
                </div>
                <div class="review-content-wrapper">
                  <div class="review-card" style="background-color: {{ section.settings.comment_background }}">
                    <div class="reviewer-name" style="color: {{ section.settings.name_color }}">{{ block.settings.name }}</div>
                    <p class="review-content" style="color: {{ section.settings.text_color }}">{{ block.settings.comment }}</p>
                  </div>
                  <div class="review-meta">
                    <div class="review-actions">
                      <span class="review-action" style="color: {{ section.settings.action_color }}">{{ section.settings.like_text }}</span>
                      <span class="review-action" style="color: {{ section.settings.action_color }}">{{ section.settings.reply_text }}</span>
                    </div>
                    <div class="review-time" style="color: {{ section.settings.date_color }}">{{ block.settings.date }}</div>
                  </div>
                </div>
              </div>
            {% endif %}
          {% endif %}
        {% endfor %}
      </div>
      
      <!-- Column 3 (desktop only) -->
      <div class="reviews-column desktop-only">
        {% for block in section.blocks %}
          {% assign modulo = forloop.index | modulo: 3 %}
          {% if modulo == 0 %}
            {% if block.type == 'review' %}
              <div class="review-item" {{ block.shopify_attributes }}>
                <div class="profile-pic">
                  {% if block.settings.profile_image != blank %}
                    <img src="{{ block.settings.profile_image | img_url: '100x100', crop: 'center' }}" alt="{{ block.settings.name }}">
                  {% else %}
                    <img src="{{ 'user-placeholder.png' | asset_url }}" alt="Profile Picture">
                  {% endif %}
                </div>
                <div class="review-content-wrapper">
                  <div class="review-card" style="background-color: {{ section.settings.comment_background }}">
                    <div class="reviewer-name" style="color: {{ section.settings.name_color }}">{{ block.settings.name }}</div>
                    <p class="review-content" style="color: {{ section.settings.text_color }}">{{ block.settings.comment }}</p>
                  </div>
                  <div class="review-meta">
                    <div class="review-actions">
                      <span class="review-action" style="color: {{ section.settings.action_color }}">{{ section.settings.like_text }}</span>
                      <span class="review-action" style="color: {{ section.settings.action_color }}">{{ section.settings.reply_text }}</span>
                    </div>
                    <div class="review-time" style="color: {{ section.settings.date_color }}">{{ block.settings.date }}</div>
                  </div>
                </div>
              </div>
            {% endif %}
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>


<style>
  #facebook-reviews-{{ section.id }} {
    padding: {{ section.settings.section_padding }}px 0;
  }
  
  #facebook-reviews-{{ section.id }} .reviews-container {
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
    padding: 10px;
  }
  
  #facebook-reviews-{{ section.id }} .reviews-title {
    text-align: center;
    font-size: {{ section.settings.title_size }}px;
    margin-bottom: 4px;
    letter-spacing: var(--letter-spacing-heading);
    font-weight: var(--font-weight-bold);
  }
  
  #facebook-reviews-{{ section.id }} .title-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 30px;
  }
  
  #facebook-reviews-{{ section.id }} .facebook-views-badge {
    display: inline-flex !important;
    align-items: center !important;
    padding: 5px 15px !important;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif !important;
    font-size: 11px !important;
    color: white !important;
    position: relative !important;
    margin-top: 12px;
    background: rgba(24, 119, 242, 0.83);
    border-radius: 17px;
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    border: 1px solid rgba(24, 119, 242, 0.3);
  }
  
  #facebook-reviews-{{ section.id }} .facebook-views-badge::before {
    content: none !important;
  }
  
  #facebook-reviews-{{ section.id }} .facebook-icon {
    margin-right: 9px !important;
  }
  
  #facebook-reviews-{{ section.id }} .facebook-text {
    letter-spacing: var(--letter-spacing-body);
    font-weight: var(--font-weight-regular);
  }
  
  #facebook-reviews-{{ section.id }} #facebook-counter-{{ section.id }} {
    font-weight: var(--font-weight-semibold);
  }
  
  #facebook-reviews-{{ section.id }} .reviews-grid {
    display: flex;
    flex-wrap: wrap;
    margin: 0 -{{ section.settings.column_spacing }}px;
  }
  
  #facebook-reviews-{{ section.id }} .reviews-column {
    flex: 0 0 50%;
    padding: 0 5px;
    display: flex;
    flex-direction: column;
  }
  
  #facebook-reviews-{{ section.id }} .review-item {
    display: flex;
    margin-bottom: {{ section.settings.review_spacing }}px;
    width: 100%;
  }
  
  #facebook-reviews-{{ section.id }} .review-content-wrapper {
    flex-grow: 1;
  }
  
  #facebook-reviews-{{ section.id }} .profile-pic {
    width: {{ section.settings.profile_size }}px;
    height: {{ section.settings.profile_size }}px;
    border-radius: 50%;
    overflow: hidden;
    margin-right: 10px;
    flex-shrink: 0;
  }
  
  #facebook-reviews-{{ section.id }} .profile-pic img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  #facebook-reviews-{{ section.id }} .review-card {
    border-radius: 10px;
    padding: 12px;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
    width: 100%;
    margin-bottom: 4px;
    height: auto;
    overflow: hidden;
  }
  
  #facebook-reviews-{{ section.id }} .reviewer-info {
    margin-bottom: 3px;
  }
  
  #facebook-reviews-{{ section.id }} .reviewer-name {
    font-weight: var(--font-weight-bold);
    font-size: 13px;
  }
  
  #facebook-reviews-{{ section.id }} .review-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  #facebook-reviews-{{ section.id }} .review-time {
    font-size: 11px;
    text-align: right;
  }
  
  #facebook-reviews-{{ section.id }} .review-content {
    font-size: 13px;
    line-height: 1.3;
    padding: 0px;
    word-wrap: break-word;
    margin-top: 2px;
    margin-bottom: 2px;
    letter-spacing: var(--letter-spacing-body);
  }
  
  #facebook-reviews-{{ section.id }} .review-actions {
    display: flex;
    font-size: 12px;
    padding-left: 5px;
  }
  
  #facebook-reviews-{{ section.id }} .review-action {
    margin-right: 15px;
    cursor: pointer;
    font-weight: var(--font-weight-semibold);
  }
  
  @media (min-width: 768px) {
    #facebook-reviews-{{ section.id }} .reviews-column {
      flex: 0 0 33.333%;
    }
    
    #facebook-reviews-{{ section.id }} .desktop-only {
      display: flex;
    }
    
    #facebook-reviews-{{ section.id }} .mobile-only {
      display: none;
    }
  }
  
  @media (max-width: 767px) {
    #facebook-reviews-{{ section.id }} .desktop-only {
      display: none;
    }
    
    #facebook-reviews-{{ section.id }} .mobile-only {
      display: block;
    }
    
    /* Redistribute reviews in two columns for mobile */
    #facebook-reviews-{{ section.id }} .reviews-column:nth-child(1) .review-item:nth-child(3n) {
      display: flex;
    }
    
    #facebook-reviews-{{ section.id }} .reviews-column:nth-child(2) .review-item:nth-child(3n) {
      display: flex;
    }
  }
  
  @media (max-width: 768px) {
    #facebook-reviews-{{ section.id }} .facebook-views-badge {
      font-size: 12px !important;
      padding: 4px 15px !important;
    }
    
    #facebook-reviews-{{ section.id }} .facebook-icon {
      width: 14px !important;
      height: 14px !important;
      margin-right: 9px !important;
    }
  }
  
  /* Small mobile devices (two columns with scaled down elements) */
  @media (max-width: 474px) {
    #facebook-reviews-{{ section.id }} .reviews-grid {
      margin: 0 -3px;
    }
    
    #facebook-reviews-{{ section.id }} .reviews-column {
      flex: 0 0 50%; /* Keep two columns */
      padding: 0 8px;
    }
    
    #facebook-reviews-{{ section.id }} .reviews-title {
      font-size: calc({{ section.settings.title_size }}px * 0.9);
      margin-bottom: 4px;
    }
    
    #facebook-reviews-{{ section.id }} .review-item {
      margin-bottom: 5px; /* Keep 5px spacing */
    }
    
    #facebook-reviews-{{ section.id }} .profile-pic {
      width: calc({{ section.settings.profile_size }}px * 0.6);
      height: calc({{ section.settings.profile_size }}px * 0.6);
      margin-right: 11px;
    }
    
    #facebook-reviews-{{ section.id }} .review-card {
      padding: 10px;
      border-radius: 8px;
    }
    
    #facebook-reviews-{{ section.id }} .reviewer-name {
      font-size: 11px;
    }
    
    #facebook-reviews-{{ section.id }} .review-time {
      font-size: 9px;
    }
    
    #facebook-reviews-{{ section.id }} .review-content {
      font-size: 11px;
      line-height: 1.2;
    }
    
    #facebook-reviews-{{ section.id }} .review-actions {
      font-size: 10px;
      padding-left: 2px;
    }
    
    #facebook-reviews-{{ section.id }} .review-action {
      margin-right: 8px;
    }
  }
  
  /* Very small mobile devices (single column only for extremely small screens) */
  @media (max-width: 400px) {
    #facebook-reviews-{{ section.id }} .reviews-column {
      flex: 0 0 50%; /* Keep as two columns */
    }
    
    #facebook-reviews-{{ section.id }} .reviews-container {
      padding: 10px;
    }
    
    #facebook-reviews-{{ section.id }} .profile-pic {
      width: calc({{ section.settings.profile_size }}px * 0.7);
      height: calc({{ section.settings.profile_size }}px * 0.7);
      margin-right: 10px;
    }
    
    #facebook-reviews-{{ section.id }} .review-card {
      padding: 8px;
      border-radius: 6px;
    }
    
    #facebook-reviews-{{ section.id }} .reviewer-name {
      font-size: 11px;
    }
    
    #facebook-reviews-{{ section.id }} .review-time {
      font-size: 9px;
    }
    
    #facebook-reviews-{{ section.id }} .review-content {
      font-size: 10px;
      line-height: 1.3;
    }
    
    #facebook-reviews-{{ section.id }} .review-actions {
      font-size: 10px;
    }
  }
</style>

{% schema %}
{
  "name": "Facebook Reviews",
  "class": "facebook-reviews-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Latest Facebook Reviews"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 16,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Title Size",
      "default": 48
    },
    {
      "type": "range",
      "id": "profile_size",
      "min": 30,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Profile Picture Size",
      "default": 40
    },
    {
      "type": "range",
      "id": "container_width",
      "min": 600,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Container Width",
      "default": 1200
    },
    {
      "type": "range",
      "id": "section_padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Section Padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "column_spacing",
      "min": 3,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Column Spacing",
      "default": 5
    },
    {
      "type": "range",
      "id": "review_spacing",
      "min": 3,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Review Spacing",
      "default": 5
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "transparent"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "comment_background",
      "label": "Comment Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "name_color",
      "label": "Username Color",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "date_color",
      "label": "Date Color",
      "default": "#65676B"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Comment Text Color",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "action_color",
      "label": "Action Button Color",
      "default": "#65676B"
    },
    {
      "type": "text",
      "id": "like_text",
      "label": "Like Button Text",
      "default": "Like"
    },
    {
      "type": "text",
      "id": "reply_text",
      "label": "Reply Button Text",
      "default": "Reply"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "image_picker",
          "id": "profile_image",
          "label": "Profile Image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Reviewer Name",
          "default": "John Doe"
        },
        {
          "type": "textarea",
          "id": "comment",
          "label": "Review Comment",
          "default": "This product is amazing! I highly recommend it to everyone."
        },
        {
          "type": "text",
          "id": "date",
          "label": "Time Display",
          "default": "48 min"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Facebook Reviews",
      "category": "Social",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "name": "card_king620",
            "comment": "I had a brutal shoulder injury from wrestling, this is the only thing that has helped. Miracle stuff!",
            "date": "48 min"
          }
        },
        {
          "type": "review",
          "settings": {
            "name": "Reynir Sigurvir Bryniόlfsson",
            "comment": "Works great miracle stuff for me suffer from chronic pain for years!",
            "date": "19 min"
          }
        },
        {
          "type": "review",
          "settings": {
            "name": "Randy Goad",
            "comment": "I am amazed at how well it has worked for me. From shoulder pain, arm pain, to knee pain from flight travel; this has done the trick!",
            "date": "35 min"
          }
        }
      ]
    }
  ]
}
{% endschema %}